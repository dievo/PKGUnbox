/* ============================================
   PKGUnbox — Dark Theme
   ============================================ */

/* === Global === */
QWidget {
    background-color: #313338;
    color: #dbdee1;
    font-family: 'gg sans', 'Noto Sans', 'Ubuntu', sans-serif;
    font-size: 14px;
}

QMainWindow {
    background-color: #313338;
}

/* === Drop Zone === */
QWidget#dropZone {
    background-color: #2b2d31;
    border: 2px dashed #4e5058;
    border-radius: 10px;
}

QWidget#dropZone:hover {
    border-color: #5865f2;
    background-color: #2f3136;
}

QLabel#dropText {
    color: #dbdee1;
    font-size: 15px;
    font-weight: bold;
}

QLabel#dropSubtext {
    color: #949ba4;
    font-size: 12px;
}

/* === Directory Container === */
QWidget#dirContainer {
    background-color: #2b2d31;
    border: 1px solid #3f4147;
    border-radius: 8px;
}

QLabel#groupTitle {
    color: #dbdee1;
    font-weight: 600;
    font-size: 13px;
    padding: 8px 0 4px 0;
}

/* === Line Edits === */
QLineEdit {
    background-color: #1e1f22;
    color: #dbdee1;
    border: none;
    border-radius: 4px;
    padding: 6px 10px;
    selection-background-color: #5865f2;
    selection-color: #ffffff;
}

QLineEdit:focus {
    background-color: #1a1b1e;
    border: 1px solid #5865f2;
}

QLineEdit:read-only {
    background-color: #2b2d31;
    color: #949ba4;
}

/* === Buttons === */
QPushButton {
    background-color: #4e5058;
    color: #dbdee1;
    border: none;
    border-radius: 4px;
    padding: 6px 14px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #6d6f78;
}

QPushButton:pressed {
    background-color: #3e4046;
}

QPushButton:disabled {
    background-color: #2b2d31;
    color: #4e5058;
}

/* Extract button — Primary CTA */
QPushButton#extractBtn {
    background-color: #5865f2;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 10px 32px;
    border-radius: 8px;
}

QPushButton#extractBtn:hover {
    background-color: #4752c4;
}

QPushButton#extractBtn:pressed {
    background-color: #3c45a5;
}

QPushButton#extractBtn:disabled {
    background-color: #2b2d31;
    color: #4e5058;
}

/* Cancel button — Red */
QPushButton#cancelBtn {
    background-color: #da373c;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    border-radius: 8px;
}

QPushButton#cancelBtn:hover {
    background-color: #a12d31;
}

/* Save button — Compact, inline */
QPushButton#saveBtn {
    background-color: transparent;
    color: #22c55e;
    border: 1px solid #166534;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#saveBtn:hover {
    background-color: #14532d;
    border-color: #22c55e;
}

QPushButton#saveBtn:disabled {
    color: #4e5058;
    border: 1px solid #3f4147;
}

/* Browse buttons */
QPushButton#browseBtn {
    background-color: #4e5058;
    color: #dbdee1;
    padding: 4px;
}

QPushButton#browseBtn:hover {
    background-color: #6d6f78;
}

/* Detect shadPS4 button — Compact, inline */
QPushButton#detectBtn {
    background-color: transparent;
    color: #f0c674;
    border: 1px solid #7d6a30;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#detectBtn:hover {
    background-color: #4a3f1f;
    border-color: #f0c674;
}

QPushButton#detectBtn:disabled {
    color: #4e5058;
    border: 1px solid #3f4147;
}

/* Clear file button */
QPushButton#clearFileBtn {
    background-color: #da373c;
    color: #ffffff;
    padding: 4px;
    border-radius: 4px;
}

QPushButton#clearFileBtn:hover {
    background-color: #a12d31;
}

/* Clear files button — Compact, inline */
QPushButton#clearFilesBtn {
    background-color: transparent;
    color: #ef4444;
    border: 1px solid #7f1d1d;
    border-radius: 4px;
    padding: 4px 12px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#clearFilesBtn:hover {
    background-color: #450a0a;
    border-color: #ef4444;
    color: #fca5a5;
}

/* === File List Items === */
QLabel#fileItemName {
    color: #dbdee1;
    font-size: 12px;
}

QLabel#fileItemSize {
    color: #949ba4;
    font-size: 11px;
}

QPushButton#removeFileBtn {
    background-color: transparent;
    border: none;
    border-radius: 4px;
    padding: 2px;
}

QPushButton#removeFileBtn:hover {
    background-color: #450a0a;
}

/* File list widget */
QListWidget {
    background-color: #2b2d31;
    border: 1px solid #3f4147;
    border-radius: 6px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    border-radius: 4px;
    padding: 2px;
}

QListWidget::item:selected {
    background-color: #363840;
}

QListWidget::item:hover {
    background-color: #33353b;
}

/* === Log Label === */
QLabel#logLabel {
    color: #949ba4;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 0;
}

QPushButton#copyLogBtn {
    background-color: transparent;
    color: #949ba4;
    border: 1px solid #3f4147;
    border-radius: 4px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
}

QPushButton#copyLogBtn:hover {
    background-color: #4e5058;
    color: #dbdee1;
    border-color: #6d6f78;
}

/* === Text Edit (Log) === */
QTextEdit {
    background-color: #2b2d31;
    color: #dbdee1;
    border: 1px solid #3f4147;
    border-radius: 6px;
    padding: 8px;
    font-family: 'Consolas', 'Fira Code', 'JetBrains Mono', monospace;
    font-size: 12px;
    selection-background-color: #5865f2;
}

/* === Scrollbar === */
QScrollBar:vertical {
    background-color: transparent;
    width: 6px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background-color: #1a1b1e;
    border-radius: 3px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4e5058;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

/* === Progress Bar === */
QProgressBar {
    border: 1px solid #3f4147;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    background-color: #2b2d31;
    font-weight: 600;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #5865f2;
    border-radius: 3px;
}

QProgressBar[complete="true"] {
    color: #1a1b1e;
}

QProgressBar[complete="true"]::chunk {
    background-color: #22c55e;
    border-radius: 3px;
}

/* === Labels === */
QLabel {
    color: #dbdee1;
    background: transparent;
}

QLabel#statusLabel {
    color: #949ba4;
    font-size: 11px;
    padding: 2px 0;
}

/* === Tool Tips === */
QToolTip {
    background-color: #111214;
    color: #dbdee1;
    border: 1px solid #3f4147;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 12px;
}

/* === Frame separators === */
QFrame[frameShape="4"],
QFrame[frameShape="5"] {
    color: #3f4147;
}
